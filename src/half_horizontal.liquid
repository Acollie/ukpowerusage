{% assign root_id = "ukgrid-hh-" | append_random %}{% assign chart_id = "ukgrid-chart-hh-" | append_random %}
<div class="layout layout--row gap--medium" id="{{ root_id }}">
  <div class="flex flex--col gap--xsmall w--40 lg:w--60" data-ukgrid-header="top">
      <div class="item" data-ukgrid-top="0">
        <div class="meta"></div>
        <div class="content">
          <div class="flex flex--row gap--small flex--center-y">
            <div class="outline p--1"><div class="w--5 h--5 lg:w--10 lg:h--10 rounded--small" data-swatch></div></div>
            <span class="value value--xsmall lg:value--large value--tnums" data-ukgrid="top-gw">--</span>
          </div>
          <span class="label lg:label--large"><span data-ukgrid="top-name"></span>&nbsp;·&nbsp;<span data-ukgrid="top-pct"></span></span>
        </div>
      </div>
      <div class="item" data-ukgrid-top="1">
        <div class="meta"></div>
        <div class="content">
          <div class="flex flex--row gap--small flex--center-y">
            <div class="outline p--1"><div class="w--5 h--5 lg:w--10 lg:h--10 rounded--small" data-swatch></div></div>
            <span class="value value--xsmall lg:value--large value--tnums" data-ukgrid="top-gw">--</span>
          </div>
          <span class="label lg:label--large"><span data-ukgrid="top-name"></span>&nbsp;·&nbsp;<span data-ukgrid="top-pct"></span></span>
        </div>
      </div>
      <div class="item" data-ukgrid-top="2">
        <div class="meta"></div>
        <div class="content">
          <div class="flex flex--row gap--small flex--center-y">
            <div class="outline p--1"><div class="w--5 h--5 lg:w--10 lg:h--10 rounded--small" data-swatch></div></div>
            <span class="value value--xsmall lg:value--large value--tnums" data-ukgrid="top-gw">--</span>
          </div>
          <span class="label lg:label--large"><span data-ukgrid="top-name"></span>&nbsp;·&nbsp;<span data-ukgrid="top-pct"></span></span>
        </div>
      </div>
  </div>
  <div class="flex flex--col gap--xsmall w--40 lg:w--60" data-ukgrid-header="summary">
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--xsmall lg:value--large value--tnums" data-ukgrid="now">--</span>
          <span class="label lg:label--large">GW now</span>
        </div>
      </div>
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--xsmall lg:value--large value--tnums" data-ukgrid="low">--</span>
          <span class="label lg:label--large">Low carbon</span>
        </div>
      </div>
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--xsmall lg:value--large value--tnums" data-ukgrid="intensity">--</span>
          <span class="label lg:label--large">gCO₂/kWh</span>
        </div>
      </div>
  </div>
  <div id="{{ chart_id }}" class="grow h--full"></div>
</div>
<div class="title_bar">
  <span class="title">UK Grid · <span data-ukgrid="unit">GW</span> · <span data-ukgrid="window">last 24h</span></span>
  <span class="instance"><span data-ukgrid="now"></span> GW now · <span data-ukgrid="updated"></span></span>
</div>
<script type="text/javascript">
  ukgridRender({ root: "{{ root_id }}", chart: "{{ chart_id }}", height: null });
</script>
