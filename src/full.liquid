<div class="layout layout--col gap--small" id="ukgrid-full">
  <div class="grid grid--cols-4" data-ukgrid-header="top">
      <div class="item" data-ukgrid-top="0">
        <div class="meta"></div>
        <div class="content">
          <div class="flex flex--row gap--small flex--center-y">
            <div class="w--10 h--10 lg:w--16 lg:h--16 rounded--small" style="outline:2px solid #000;outline-offset:-2px" data-swatch></div>
            <span class="value lg:value--xlarge lg:portrait:value--base value--tnums" data-ukgrid="top-gw">--</span>
          </div>
          <span class="label lg:label--large"><span data-ukgrid="top-name"></span>&nbsp;·&nbsp;<span data-ukgrid="top-pct"></span></span>
        </div>
      </div>
      <div class="item" data-ukgrid-top="1">
        <div class="meta"></div>
        <div class="content">
          <div class="flex flex--row gap--small flex--center-y">
            <div class="w--10 h--10 lg:w--16 lg:h--16 rounded--small" style="outline:2px solid #000;outline-offset:-2px" data-swatch></div>
            <span class="value lg:value--xlarge lg:portrait:value--base value--tnums" data-ukgrid="top-gw">--</span>
          </div>
          <span class="label lg:label--large"><span data-ukgrid="top-name"></span>&nbsp;·&nbsp;<span data-ukgrid="top-pct"></span></span>
        </div>
      </div>
      <div class="item" data-ukgrid-top="2">
        <div class="meta"></div>
        <div class="content">
          <div class="flex flex--row gap--small flex--center-y">
            <div class="w--10 h--10 lg:w--16 lg:h--16 rounded--small" style="outline:2px solid #000;outline-offset:-2px" data-swatch></div>
            <span class="value lg:value--xlarge lg:portrait:value--base value--tnums" data-ukgrid="top-gw">--</span>
          </div>
          <span class="label lg:label--large"><span data-ukgrid="top-name"></span>&nbsp;·&nbsp;<span data-ukgrid="top-pct"></span></span>
        </div>
      </div>
      <div class="item" data-ukgrid-top="3">
        <div class="meta"></div>
        <div class="content">
          <div class="flex flex--row gap--small flex--center-y">
            <div class="w--10 h--10 lg:w--16 lg:h--16 rounded--small" style="outline:2px solid #000;outline-offset:-2px" data-swatch></div>
            <span class="value lg:value--xlarge lg:portrait:value--base value--tnums" data-ukgrid="top-gw">--</span>
          </div>
          <span class="label lg:label--large"><span data-ukgrid="top-name"></span>&nbsp;·&nbsp;<span data-ukgrid="top-pct"></span></span>
        </div>
      </div>
  </div>
  <div class="grid grid--cols-4" data-ukgrid-header="summary">
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="value lg:value--xlarge lg:portrait:value--base value--tnums" data-ukgrid="now">--</span>
          <span class="label lg:label--large">GW now</span>
        </div>
      </div>
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="value lg:value--xlarge lg:portrait:value--base value--tnums" data-ukgrid="peak">--</span>
          <span class="label lg:label--large" data-ukgrid="peak-time">Peak GW</span>
        </div>
      </div>
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="value lg:value--xlarge lg:portrait:value--base value--tnums" data-ukgrid="low">--</span>
          <span class="label lg:label--large">Low carbon</span>
        </div>
      </div>
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="value lg:value--xlarge lg:portrait:value--base value--tnums" data-ukgrid="intensity">--</span>
          <span class="label lg:label--large">gCO₂/kWh</span>
        </div>
      </div>
  </div>
  <div id="ukgrid-chart-full" class="w--full grow"><span class="label" data-ukgrid="empty"></span></div>
  <div class="flex flex--row gap--medium flex--center-x" data-ukgrid-legend>
      <div class="flex flex--row gap--xsmall flex--center-y">
        <div class="w--4 h--4 lg:w--6 lg:h--6 rounded--small" data-chart-series="5" data-chart-series-count="6"></div>
        <span class="label label--small lg:label--base">Gas</span>
      </div>
      <div class="flex flex--row gap--xsmall flex--center-y">
        <div class="w--4 h--4 lg:w--6 lg:h--6 rounded--small" data-chart-series="4" data-chart-series-count="6"></div>
        <span class="label label--small lg:label--base">Imports</span>
      </div>
      <div class="flex flex--row gap--xsmall flex--center-y">
        <div class="w--4 h--4 lg:w--6 lg:h--6 rounded--small" data-chart-series="3" data-chart-series-count="6"></div>
        <span class="label label--small lg:label--base">Bio/Hydro</span>
      </div>
      <div class="flex flex--row gap--xsmall flex--center-y">
        <div class="w--4 h--4 lg:w--6 lg:h--6 rounded--small" data-chart-series="2" data-chart-series-count="6"></div>
        <span class="label label--small lg:label--base">Solar</span>
      </div>
      <div class="flex flex--row gap--xsmall flex--center-y">
        <div class="w--4 h--4 lg:w--6 lg:h--6 rounded--small" data-chart-series="1" data-chart-series-count="6"></div>
        <span class="label label--small lg:label--base">Wind</span>
      </div>
      <div class="flex flex--row gap--xsmall flex--center-y">
        <div class="w--4 h--4 lg:w--6 lg:h--6 rounded--small" data-chart-series="0" data-chart-series-count="6"></div>
        <span class="label label--small lg:label--base">Nuclear</span>
      </div>
  </div>
</div>
<div class="title_bar">
  <span class="title">UK Grid · <span data-ukgrid="unit">GW</span> · <span data-ukgrid="window">last 24h</span></span>
  <span class="instance"><span data-ukgrid="now"></span> GW now · peak <span data-ukgrid="peak"></span> · <span data-ukgrid="updated"></span></span>
</div>
<script type="text/javascript">
  ukgridRender({ root: "ukgrid-full", chart: "ukgrid-chart-full", height: null });
</script>
